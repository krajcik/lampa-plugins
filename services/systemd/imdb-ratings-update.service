[Unit]
Description=Refresh official IMDb ratings dataset
After=network-online.target
Wants=network-online.target

[Service]
Type=oneshot
User=imdb-ratings
StateDirectory=imdb-ratings
Environment=IMDB_RATINGS_DB=/var/lib/imdb-ratings/ratings.sqlite
ExecStart=/usr/bin/python3 /opt/imdb-ratings/imdb-ratings.py update
TimeoutStartSec=10min
MemoryMax=256M
Nice=10
NoNewPrivileges=true
ProtectSystem=strict
ProtectHome=true
PrivateTmp=true
UMask=0027
